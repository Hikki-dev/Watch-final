# Copy this file to .env and fill it in. .env is git-ignored. It is also a declared
# asset in pubspec.yaml, so the app will not build without it.
# See docs/SETUP.md for where each value comes from.

# The Laravel-Watch API, including /api. For a local backend: http://127.0.0.1:8000/api
API_BASE_URL=https://your-host/api

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Web
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_WEB_MEASUREMENT_ID=

# Android
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=

# iOS and macOS
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_BUNDLE_ID=
FIREBASE_IOS_CLIENT_ID=
FIREBASE_MACOS_API_KEY=
FIREBASE_MACOS_APP_ID=
FIREBASE_MACOS_BUNDLE_ID=
FIREBASE_MACOS_CLIENT_ID=

# Windows
FIREBASE_WINDOWS_API_KEY=
FIREBASE_WINDOWS_APP_ID=
FIREBASE_WINDOWS_AUTH_DOMAIN=
FIREBASE_WINDOWS_MEASUREMENT_ID=
